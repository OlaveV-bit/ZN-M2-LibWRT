CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ================= 无线：本机不需要 WiFi，整套 ath11k 关闭 =================
# 与之配套的 ATH11K_MEM_PROFILE 是 WiFi 固件的内存模式参数，一并去掉
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_wpad-openssl=n
CONFIG_PACKAGE_wpad-basic-mbedtls=n
CONFIG_PACKAGE_wpad-basic-wolfssl=n
CONFIG_PACKAGE_hostapd-common=n

# 有线 NSS 加速固件（与 WiFi 无关，必须保留）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

# ================= USB 3.0：魔改外接接口（DWC3 + XHCI + 存储栈） =================
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
# kmod-usb3 负责打开 CONFIG_USB_XHCI_PLATFORM，dwc3 走 host 模式要靠它
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_usbutils=y

# 外接硬盘常用文件系统 / 编码
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# 自动挂载（配合 General.config 里的 luci-app-diskman）
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
